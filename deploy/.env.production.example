# Copy thành /opt/elearning/.env trên VPS rồi điền. scripts/ops/preflight.sh
# kiểm tra file này trước khi lên public.

# ── Domain / URL ──────────────────────────────────────────────────────────────
DOMAIN=hoc.example.com                 # Caddy xin cert cho domain này (DNS A → IP VPS)
FRONTEND_URL=https://hoc.example.com   # dùng trong email kích hoạt, link share, Stripe redirect

# ── Image ─────────────────────────────────────────────────────────────────────
APP_IMAGE=ghcr.io/thaig2pro/elearning-platform:latest

# ── Postgres (compose ghép thành DATABASE_URL, không cần khai báo riêng) ──────
POSTGRES_DB=elearning
POSTGRES_USER=elearning_user
POSTGRES_PASSWORD=                     # openssl rand -base64 24

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=                            # openssl rand -base64 48  (≥32 ký tự, app từ chối khởi động nếu ngắn hơn)

# ── OAuth (Google/GitHub — 2026-09-15) ─────────────────────────────────────────
# Trống cả 4 biến = nút "Đăng nhập với Google/GitHub" vẫn hiện nhưng bấm vào
# redirect thẳng về /login?error=oauth_not_configured — không chặn phần còn
# lại của app, nhưng nên điền trước khi launch để tránh nút chết trên UI.
# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://DOMAIN/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App.
# Authorization callback URL: https://DOMAIN/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Mặc định dùng FRONTEND_URL ở trên nếu để trống — chỉ set riêng khi domain
# gọi API khác domain hiển thị (không phải trường hợp thường gặp).
OAUTH_REDIRECT_BASE_URL=

# ── AI (gọi thẳng provider, xem .env.example gốc) ─────────────────────────────
LITELLM_BASE_URL=https://api.groq.com/openai/v1
LITELLM_MASTER_KEY=                    # Groq API key
AI_DEFAULT_MODEL=openai/gpt-oss-120b
AI_DAILY_ACTIVATION_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=300              # trần toàn hệ thống/ngày (C1 docs/SURVIVAL.md), không tính BYOK
AI_SHARED_FREE_MAX_TRANSCRIPT_CHARS=60000
# Trần transcript cho nhánh trả credit (key nền tảng) — chống 1 lượt đắt hơn giá bán.
AI_PAID_MAX_TRANSCRIPT_CHARS=400000
AI_LLM_TIMEOUT_MS=60000
AI_ALERT_DAILY_REQUESTS=250
AI_GENERATION_CREDIT_COST=1            # 1 credit = 1 lượt AI tuỳ biến (khớp bảng gói trong CreditLedger.ts)

# ── Email — SMTP THẬT (Mailtrap sandbox KHÔNG gửi tới người nhận thật) ────────
# Free tier gợi ý: Brevo 300 mail/ngày (smtp-relay.brevo.com:587),
# Resend 100/ngày (smtp.resend.com:465). Tên biến giữ MAILTRAP_* để không đổi code.
MAILTRAP_HOST=smtp-relay.brevo.com
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM=noreply@hoc.example.com     # domain phải verify ở nhà cung cấp SMTP

# ── Cảnh báo Telegram (A3 docs/SURVIVAL.md — scripts/ops/alert.sh) ────────────
# Bỏ trống = alert.sh chỉ in log, không gửi gì. Lấy TOKEN từ @BotFather
# (/newbot), lấy CHAT_ID từ https://api.telegram.org/bot<TOKEN>/getUpdates
# sau khi nhắn bot 1 câu.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Thanh toán Stripe (bỏ trống STRIPE_SECRET_KEY = tắt mua credit, app vẫn chạy) ──
# Webhook endpoint trong Stripe Dashboard: https://DOMAIN/api/v1/billing/webhook
# Bật ĐỦ 4 event: checkout.session.completed, charge.refunded,
# charge.dispute.created, charge.dispute.closed (3 event sau = thu hồi credit
# khi hoàn tiền/chargeback — thiếu là khách đòi tiền lại mà credit vẫn còn).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cảnh báo vận hành về tiền: đối soát credit thấy nợ, sổ cái lệch, Stripe hoàn
# tiền / chargeback. Dán incoming webhook Discord hoặc Slack. Trống = chỉ log.
OPS_ALERT_WEBHOOK_URL=
# Cron trên VPS gọi POST /api/internal/credits/reconcile mỗi 15 phút (xem
# LAUNCH_CHECKLIST mục 7). Sinh: openssl rand -hex 32. Trống = endpoint tắt.
INTERNAL_CRON_SECRET=

# ── Tuỳ chọn ──────────────────────────────────────────────────────────────────
DATA_RETENTION_ARCHIVE_DAYS=180
# NEXT_PUBLIC_DONATE_URL KHÔNG đặt ở đây — nướng lúc build qua GitHub Actions Variables.
