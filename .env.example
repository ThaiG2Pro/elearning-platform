# ── Database ──────────────────────────────────────────────────────────────────
# For Neon (production):
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
# For local Docker (docker-compose.yml):
# DATABASE_URL="postgresql://elearning_user:elearning_pass@localhost:5432/elearning?sslmode=disable"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="replace-with-a-strong-random-secret"

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── Donate (WP1.8) ────────────────────────────────────────────────────────────
# Passive donate link shown in the header (Ko-fi/GitHub Sponsors). Neutral
# "ủng hộ" framing, no subscription logic gated on it — Vision mục 7 / wayfinder
# ticket 09. Leave unset to hide the button entirely (no fake placeholder link).
NEXT_PUBLIC_DONATE_URL="https://ko-fi.com/yourhandle"

# ── AI generation (WP2.2 — Checkpoint 2, SHARED_FREE mặc định) ────────────────
# Đa dạng provider qua LiteLLM proxy (self-host, xem litellm/config.yaml +
# docker-compose.yml) thay vì khoá cứng 1 provider — đổi Groq/OpenAI/
# Anthropic/OpenRouter/tự host chỉ cần sửa config.yaml + set đúng key dưới
# đây, không đụng code. Xem docs/design/ai-personalization-economics.md.
#
# Địa chỉ proxy LiteLLM (dev local: chạy `docker compose up litellm`, hoặc
# `pnpm litellm:dev` nếu chạy proxy ngoài Docker).
LITELLM_BASE_URL="http://localhost:4000"
# Key gọi tới CHÍNH proxy (không phải key của provider cụ thể) — set trùng
# giá trị ở đây và ở container litellm (docker-compose.yml đọc biến này).
LITELLM_MASTER_KEY="replace-with-a-strong-random-secret"
# Model alias khai báo trong litellm/config.yaml — đổi provider mặc định chỉ
# cần đổi giá trị này (vd "openai-gpt4o-mini", "anthropic-haiku",
# "openrouter-llama", "selfhost"), không sửa code.
AI_DEFAULT_MODEL="default"
# Key thật của từng provider — chỉ cần set key của provider bạn thực sự
# dùng; provider chưa cấu hình key chỉ lỗi khi bị gọi tới, không chặn các
# provider khác hay chặn khởi động proxy.
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
# Tự host (Ollama/vLLM/...) — endpoint OpenAI-compatible của server riêng.
SELFHOST_LLM_BASE_URL=""
SELFHOST_LLM_API_KEY=""
# Ngưỡng chống cost-DoS (mục 6.1) — số lần 1 user được kích hoạt AI/ngày.
AI_DAILY_ACTIVATION_LIMIT=20
# Ngưỡng token thực (mục 6.3, ước lượng ~4 ký tự/token) — Source có transcript
# dài hơn bị từ chối tạo bản SHARED_FREE, bắt buộc BYOK/trả phí.
AI_SHARED_FREE_MAX_TRANSCRIPT_CHARS=60000
# Ngưỡng cảnh báo (mục 6.7/WP2.4) — số request SHARED_FREE/ngày toàn nền
# tảng để `pnpm ai:usage-report` in cảnh báo tăng trưởng đột biến.
AI_ALERT_DAILY_REQUESTS=250

# ── Billing (WP4.1 — Checkpoint 4, gói credit trả phí) ────────────────────────
# Cắm thanh toán thật vào nhánh UX #4 đã có sẵn từ Checkpoint 3: user không
# BYOK, muốn tuỳ biến, không có bản SHARED-BYOK trùng → "Trả phí để nền tảng
# tạo giúp" (mục 4/7 economics doc). Bán theo GÓI CREDIT (không pay-per-
# generation lẻ tẻ — phí xử lý thanh toán ăn mòn doanh thu nhỏ lẻ).
# Tạo tài khoản Stripe + lấy key thật là thao tác vận hành (giống WP1.8),
# ngoài phạm vi agent code — để trống chỉ tắt route billing (503
# STRIPE_NOT_CONFIGURED), không chặn phần còn lại của app.
STRIPE_SECRET_KEY=""
# Ký từ Stripe Dashboard (hoặc `stripe listen` khi test local) — verify chữ
# ký webhook, KHÔNG xử lý payload chưa xác thực được.
STRIPE_WEBHOOK_SECRET=""
# Số credit trừ cho 1 lần generate PAID_TIER (không phân biệt summary/quiz ở
# MVP Checkpoint 4 — đơn giản hoá, khác ngưỡng token thực chỉ áp dụng cho
# SHARED_FREE ở mục 6.3).
AI_GENERATION_CREDIT_COST=10

# ── Data retention (WP4.2 — mục 6.4) ──────────────────────────────────────────
# Số ngày không truy cập (last_accessed_at) trước khi Source/AIGeneration đủ
# điều kiện archive qua `pnpm data:archive-stale -- --apply` — không archive
# nếu còn space công khai nào tham chiếu (showcase hoặc có share_token).
DATA_RETENTION_ARCHIVE_DAYS=180

# ── Email (Mailtrap for dev / real SMTP for prod) ─────────────────────────────
# Dev (Mailtrap sandbox): https://mailtrap.io
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT=2525
MAILTRAP_USER="your-mailtrap-user"
MAILTRAP_PASS="your-mailtrap-password"
MAIL_FROM="noreply@elearning.com"
