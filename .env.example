# ── Database ──────────────────────────────────────────────────────────────────
# For Neon (production):
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
# For local Docker (docker-compose.yml):
# DATABASE_URL="postgresql://elearning_user:elearning_pass@localhost:5432/elearning?sslmode=disable"
# Security fix — docker-compose.yml giờ đọc mật khẩu Postgres từ 3 biến dưới
# đây (mặc định elearning_user/elearning_pass/elearning để `docker compose
# up` vẫn chạy ngay không cần cấu hình, phù hợp dev cục bộ). Deploy thật
# (VPS, xem docs/DEPLOY.md) PHẢI đặt POSTGRES_PASSWORD riêng, không dùng
# default:
POSTGRES_DB="elearning"
POSTGRES_USER="elearning_user"
POSTGRES_PASSWORD="elearning_pass"
# Perf (2026-09-06): LUÔN thêm connection_limit khi chạy trên VPS nhỏ / Postgres
# managed free tier. Prisma mặc định mở (2*CPU+1) connection, mỗi connection
# Postgres ăn ~10MB RAM. 5 là đủ cho 1 instance Next.js.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connection_limit=5&pool_timeout=10"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="replace-with-a-strong-random-secret"

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── Donate (WP1.8) ────────────────────────────────────────────────────────────
# Passive donate link shown in the header (Ko-fi/GitHub Sponsors). Neutral
# "ủng hộ" framing, no subscription logic gated on it — Vision mục 7 / wayfinder
# ticket 09. Leave unset to hide the button entirely (no fake placeholder link).
NEXT_PUBLIC_DONATE_URL="https://ko-fi.com/yourhandle"

# ── AI generation (WP2.2 — Checkpoint 2, SHARED_FREE mặc định) ────────────────
# 2026-09-06 (quyết định nhóm E, VPS 1GB) — nhánh SHARED_FREE gọi THẲNG
# endpoint OpenAI-compatible của provider, không qua LiteLLM proxy nữa
# (proxy Python ăn 300–500MB RAM). Tên biến giữ nguyên để không đổi code:
#   LITELLM_BASE_URL   = endpoint provider    (Groq mặc định)
#   LITELLM_MASTER_KEY = API key của provider đó
#   AI_DEFAULT_MODEL   = tên model theo cách gọi của provider
# Muốn đa provider cho nhánh miễn phí: trỏ sang OpenRouter
#   (https://openrouter.ai/api/v1, model vd "meta-llama/llama-3.3-70b-instruct").
# LiteLLM vẫn còn dưới dạng profile tuỳ chọn cho máy ≥2GB
#   (docker compose --profile litellm up; LITELLM_BASE_URL=http://litellm:4000,
#    AI_DEFAULT_MODEL="default" theo alias trong litellm/config.yaml).
# Nhánh BYOK không dùng các biến này — user tự nhập endpoint/key/model.
LITELLM_BASE_URL="https://api.groq.com/openai/v1"
LITELLM_MASTER_KEY=""
AI_DEFAULT_MODEL="openai/gpt-oss-120b"
# Key thật của từng provider — CHỈ cần khi chạy profile litellm (xem trên);
# gọi thẳng provider thì dùng LITELLM_MASTER_KEY, bỏ trống các dòng này.
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
# Tự host (Ollama/vLLM/...) — endpoint OpenAI-compatible của server riêng.
SELFHOST_LLM_BASE_URL=""
SELFHOST_LLM_API_KEY=""
# Ngưỡng chống cost-DoS (mục 6.1) — số lần 1 user được kích hoạt AI/ngày.
AI_DAILY_ACTIVATION_LIMIT=20
# Ngưỡng token thực (mục 6.3, ước lượng ~4 ký tự/token) — Source có transcript
# dài hơn bị từ chối tạo bản SHARED_FREE, bắt buộc BYOK/trả phí.
AI_SHARED_FREE_MAX_TRANSCRIPT_CHARS=60000
# Perf (2026-09-06): timeout 1 lời gọi LLM (ms). Request AI là sync nên đây
# cũng là thời gian tối đa 1 HTTP request của user bị giữ. Mặc định 60000.
AI_LLM_TIMEOUT_MS=60000
# Ngưỡng cảnh báo (mục 6.7/WP2.4) — số request SHARED_FREE/ngày toàn nền
# tảng để `pnpm ai:usage-report` in cảnh báo tăng trưởng đột biến.
AI_ALERT_DAILY_REQUESTS=250

# ── Billing (WP4.1 — Checkpoint 4, gói credit trả phí) ────────────────────────
# Cắm thanh toán thật vào nhánh UX #4 đã có sẵn từ Checkpoint 3: user không
# BYOK, muốn tuỳ biến, không có bản SHARED-BYOK trùng → "Trả phí để nền tảng
# tạo giúp" (mục 4/7 economics doc). Bán theo GÓI CREDIT (không pay-per-
# generation lẻ tẻ — phí xử lý thanh toán ăn mòn doanh thu nhỏ lẻ).
# Tạo tài khoản Stripe + lấy key thật là thao tác vận hành (giống WP1.8),
# ngoài phạm vi agent code — để trống chỉ tắt route billing (503
# STRIPE_NOT_CONFIGURED), không chặn phần còn lại của app.
STRIPE_SECRET_KEY=""
# Ký từ Stripe Dashboard (hoặc `stripe listen` khi test local) — verify chữ
# ký webhook, KHÔNG xử lý payload chưa xác thực được.
STRIPE_WEBHOOK_SECRET=""
# Số credit trừ cho 1 lần generate PAID_TIER (không phân biệt summary/quiz ở
# MVP Checkpoint 4 — đơn giản hoá, khác ngưỡng token thực chỉ áp dụng cho
# SHARED_FREE ở mục 6.3).
AI_GENERATION_CREDIT_COST=10

# ── Data retention (WP4.2 — mục 6.4) ──────────────────────────────────────────
# Số ngày không truy cập (last_accessed_at) trước khi Source/AIGeneration đủ
# điều kiện archive qua `pnpm data:archive-stale -- --apply` — không archive
# nếu còn space công khai nào tham chiếu (showcase hoặc có share_token).
DATA_RETENTION_ARCHIVE_DAYS=180

# ── Support widget (SalesAgentWidget — trợ lý FAQ, không phải AI thật) ────────
# Kênh liên hệ "người thật" hiển thị cố định trong widget chat trang chủ/join/
# pricing (footer luôn hiện + fallback khi bot không match được câu hỏi).
# Ưu tiên NEXT_PUBLIC_SUPPORT_CHAT_URL (vd link Zalo/Messenger) nếu có; không
# có thì fallback mailto: theo NEXT_PUBLIC_SUPPORT_EMAIL. Để trống cả 2 vẫn
# chạy được — widget sẽ xử lý mềm (không đưa link chết cho khách).
NEXT_PUBLIC_SUPPORT_CHAT_URL=""
NEXT_PUBLIC_SUPPORT_EMAIL=""

# ── Email (Mailtrap for dev / real SMTP for prod) ─────────────────────────────
# Dev (Mailtrap sandbox): https://mailtrap.io
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT=2525
MAILTRAP_USER="your-mailtrap-user"
MAILTRAP_PASS="your-mailtrap-password"
MAIL_FROM="noreply@elearning.com"
