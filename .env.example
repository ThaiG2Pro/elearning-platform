# ── Database ──────────────────────────────────────────────────────────────────
# For Neon (production):
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"
# For local Docker (docker-compose.yml):
# DATABASE_URL="postgresql://elearning_user:elearning_pass@localhost:5432/elearning?sslmode=disable"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="replace-with-a-strong-random-secret"

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── Donate (WP1.8) ────────────────────────────────────────────────────────────
# Passive donate link shown in the header (Ko-fi/GitHub Sponsors). Neutral
# "ủng hộ" framing, no subscription logic gated on it — Vision mục 7 / wayfinder
# ticket 09. Leave unset to hide the button entirely (no fake placeholder link).
NEXT_PUBLIC_DONATE_URL="https://ko-fi.com/yourhandle"

# ── AI generation (WP2.2 — Checkpoint 2, SHARED_FREE mặc định) ────────────────
# Key nền tảng gánh cho recipe mặc định (tóm tắt/quiz), route BYOK dùng key
# riêng của user thay vì key này — xem docs/design/ai-personalization-economics.md.
# Không set = tính năng AI mặc định tắt hẳn (SHARED_FREE_NOT_CONFIGURED), không
# chặn phần còn lại của app (AI luôn optional).
GEMINI_API_KEY=""
# Ngưỡng chống cost-DoS (mục 6.1) — số lần 1 user được kích hoạt AI/ngày.
AI_DAILY_ACTIVATION_LIMIT=20
# Ngưỡng token thực (mục 6.3, ước lượng ~4 ký tự/token) — Source có transcript
# dài hơn bị từ chối tạo bản SHARED_FREE, bắt buộc BYOK/trả phí.
AI_SHARED_FREE_MAX_TRANSCRIPT_CHARS=60000
# Ngưỡng cảnh báo (mục 6.7/WP2.4) — số request SHARED_FREE/ngày toàn nền
# tảng để `pnpm ai:usage-report` in cảnh báo tăng trưởng đột biến.
AI_ALERT_DAILY_REQUESTS=250

# ── Email (Mailtrap for dev / real SMTP for prod) ─────────────────────────────
# Dev (Mailtrap sandbox): https://mailtrap.io
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT=2525
MAILTRAP_USER="your-mailtrap-user"
MAILTRAP_PASS="your-mailtrap-password"
MAIL_FROM="noreply@elearning.com"
