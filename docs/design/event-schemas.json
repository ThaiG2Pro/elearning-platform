{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LMS Domain Events - Schemas & Samples",
  "description": "Canonical event schemas and example payloads for cross-context communication",
  "type": "object",
  "properties": {
    "UserCreated": {
      "description": "Emitted when a new user account is created (registration or import)",
      "example": {
        "meta": {
          "eventId": "uuid-v4",
          "traceId": "trace-1234",
          "source": "auth-service",
          "version": "1.0",
          "timestamp": "2026-05-22T23:00:00Z",
          "idempotencyKey": "external-op-123"
        },
        "payload": {
          "userId": 12345,
          "email": "student@example.com",
          "role": "STUDENT",
          "status": "ACTIVE",
          "displayName": "Nguyen Van A"
        }
      },
      "schema": {
        "type": "object",
        "required": ["meta","payload"],
        "properties": {
          "meta": { "type": "object" },
          "payload": {
            "type": "object",
            "required": ["userId","email","role"],
            "properties": {
              "userId": { "type": "integer" },
              "email": { "type": "string", "format": "email" },
              "role": { "type": "string" },
              "status": { "type": "string" },
              "displayName": { "type": "string" }
            }
          }
        }
      }
    },

    "CoursePublished": {
      "description": "Emitted when a course transitions to PUBLISHED state",
      "example": {
        "meta": { "eventId": "uuid-1", "traceId": "t-1", "source": "management-service", "version": "1.0", "timestamp": "2026-05-22T23:01:00Z" },
        "payload": {
          "courseId": 9876,
          "slug": "intro-to-nodejs",
          "lecturerId": 55,
          "publishedAt": "2026-05-22T23:00:55Z",
          "visibility": "PUBLIC"
        }
      },
      "schema": {
        "type": "object",
        "required": ["meta","payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["courseId","slug","lecturerId"],
            "properties": {
              "courseId": { "type": "integer" },
              "slug": { "type": "string" },
              "lecturerId": { "type": "integer" },
              "publishedAt": { "type": "string", "format": "date-time" },
              "visibility": { "type": "string" }
            }
          }
        }
      }
    },

    "EnrollmentCreated": {
      "description": "Emitted after a student successfully enrolls in a course",
      "example": {
        "meta": { "eventId": "uuid-2", "traceId": "t-2", "source": "enrollment-service", "version": "1.0", "timestamp": "2026-05-22T23:02:00Z" },
        "payload": {
          "enrollmentId": 5555,
          "userId": 12345,
          "courseId": 9876,
          "enrolledAt": "2026-05-22T23:01:54Z"
        }
      },
      "schema": {
        "type": "object",
        "required": ["meta","payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["enrollmentId","userId","courseId"],
            "properties": {
              "enrollmentId": { "type": "integer" },
              "userId": { "type": "integer" },
              "courseId": { "type": "integer" },
              "enrolledAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },

    "QuizSubmitted": {
      "description": "Emitted when a user submits a quiz attempt (auto-graded or hand-graded)",
      "example": {
        "meta": { "eventId": "uuid-3", "traceId": "t-3", "source": "quiz-service", "version": "1.0", "timestamp": "2026-05-22T23:03:00Z" },
        "payload": {
          "attemptId": 9001,
          "userId": 12345,
          "lessonId": 4444,
          "answers": [{ "questionId": 1, "answer": "A" }, { "questionId": 2, "answer": "C" }],
          "submittedAt": "2026-05-22T23:02:47Z",
          "isAutoGraded": true
        }
      },
      "schema": {
        "type": "object",
        "required": ["meta","payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["attemptId","userId","lessonId","answers"],
            "properties": {
              "attemptId": { "type": "integer" },
              "userId": { "type": "integer" },
              "lessonId": { "type": "integer" },
              "answers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["questionId","answer"],
                  "properties": {
                    "questionId": { "type": "integer" },
                    "answer": { "type": "string" }
                  }
                }
              },
              "submittedAt": { "type": "string", "format": "date-time" },
              "isAutoGraded": { "type": "boolean" }
            }
          }
        }
      }
    },

    "ProgressUpdated": {
      "description": "User playback/progress updates (emit at safe intervals or on close)",
      "example": {
        "meta": { "eventId": "uuid-4", "traceId": "t-4", "source": "learning-service", "version": "1.0", "timestamp": "2026-05-22T23:04:00Z" },
        "payload": {
          "userId": 12345,
          "lessonId": 4444,
          "videoPositionSeconds": 312,
          "isFinished": false,
          "updatedAt": "2026-05-22T23:03:55Z"
        }
      },
      "schema": {
        "type": "object",
        "required": ["meta","payload"],
        "properties": {
          "payload": {
            "type": "object",
            "required": ["userId","lessonId"],
            "properties": {
              "userId": { "type": "integer" },
              "lessonId": { "type": "integer" },
              "videoPositionSeconds": { "type": "integer" },
              "isFinished": { "type": "boolean" },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
