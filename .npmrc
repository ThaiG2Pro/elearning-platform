# pnpm settings — committed to git, applies to all developers

# Enforce strict engine check (Node version must match .mise.toml)
engine-strict=false

# Hoisting: prevent phantom dependencies (strict isolation)
node-linker=hoisted

# Saves disk: pnpm uses a content-addressable store shared across projects
# Store path is managed by pnpm automatically (~/.local/share/pnpm/store)

# Block usage of other package managers (corepack enforces this via packageManager field)
# If a teammate runs `npm install`, corepack will redirect to pnpm
