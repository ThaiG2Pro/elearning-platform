generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (schema hardening 2026-08-21) ─────────────────────────────────────
// Trước đây các cột status/type đều là VarChar tự do — DB nhận mọi string,
// một typo ở tầng service (đặc biệt key_source/visibility, thứ quyết định
// tiền và quyền riêng tư) nằm im trong data không ai phát hiện. Enum Postgres
// chặn sai giá trị ngay tại DB, gần như miễn phí với app mới.

enum user_role {
  STUDENT
  LECTURER
  ADMIN
}

// INACTIVE = chưa kích hoạt (chờ activation, bị dọn sau 24h) — giá trị
// 'PENDING' cũ trong seed đã được migrate về INACTIVE cho thống nhất với code.
// DELETED = soft-delete (WP1.5.6).
enum user_status {
  INACTIVE
  ACTIVE
  DELETED
}

enum token_type {
  ACTIVATION
  RECOVERY
}

enum source_type {
  YOUTUBE_VIDEO
  WEB_ARTICLE
}

enum course_status {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum lesson_type {
  VIDEO
  QUIZ
  ARTICLE
}

enum ai_recipe_type {
  summary
  quiz
}

enum ai_key_source {
  SHARED_FREE
  BYOK
  PAID_TIER
}

enum ai_visibility {
  PRIVATE
  SHARED
}

enum ai_status {
  PENDING
  READY
  FAILED
}

enum credit_reason {
  PURCHASE
  AI_GENERATION_SPEND
  REFUND
}

model users {
  id                BigInt              @id @default(autoincrement()) @map("id")
  email             String              @unique @map("email") @db.VarChar(255)
  password_hash     String              @map("password_hash") @db.VarChar(255)
  full_name         String              @map("full_name") @db.VarChar(100)
  age               Int?                @map("age")
  // Thay bảng roles + role_id: chỉ có ~3 role tĩnh, không có permission
  // matrix — bảng riêng chỉ thêm 1 join cho mọi lần auth mà không mua được gì.
  role              user_role           @default(STUDENT) @map("role")
  status            user_status         @map("status")
  created_at        DateTime?           @map("created_at") @db.Timestamp(6)
  // WP4.1 — số dư credit hiện tại (nguồn nhanh để check trước generate);
  // lịch sử đầy đủ từng giao dịch nằm ở credit_transactions.
  credit_balance      Int                 @default(0) @map("credit_balance")
  // WP4.1 — Stripe Customer id, tạo lười (lazy) ở lần mua credit đầu tiên.
  stripe_customer_id  String?             @unique @map("stripe_customer_id") @db.VarChar(255)
  // Avatar (ảnh data-URL, có thể hàng trăm KB) tách sang user_avatars —
  // bảng users là bảng nóng nhất (auth, join khắp nơi), không để nó cõng blob.
  avatar            user_avatars?
  owned_courses     courses[]           @relation("CourseOwner")
  learning_progress learning_progress[]
  notes             notes[]
  tokens            tokens[]
  // WP2.1 — AI generations this user personally triggered. Set to NULL on
  // account deletion, never cascade-deleted (ghi chú 2, mục 3 economics doc).
  ai_generations    ai_generations[]
  credit_transactions credit_transactions[]

  @@map("users")
}

// WP1.5.6 (tách khỏi users 2026-08-21): client-side-resized avatar image,
// stored as a data: URL — no file storage exists anywhere in this codebase
// (no S3/disk-upload infra) and this app targets Vercel-style serverless
// where writing to disk at runtime isn't reliable, so the DB is the simplest
// safe place for it. 1-1 với users, PK = user_id.
model user_avatars {
  user_id    BigInt   @id @map("user_id")
  data       String   @map("data") @db.Text
  updated_at DateTime @default(now()) @updatedAt @map("updated_at")
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

// WP4.1 (Checkpoint 4) — ledger đầy đủ, audit lại được số dư credit_balance.
// unique(stripe_reference) chống Stripe gửi trùng webhook cộng credit 2 lần.
model credit_transactions {
  id                BigInt        @id @default(autoincrement()) @map("id")
  user_id           BigInt        @map("user_id")
  // Dương = mua/hoàn, âm = tiêu cho 1 lần generate PAID_TIER.
  amount            Int           @map("amount")
  reason            credit_reason @map("reason")
  // Stripe session/payment_intent id — null cho SPEND/REFUND nội bộ.
  stripe_reference  String?       @unique @map("stripe_reference") @db.VarChar(255)
  balance_after     Int           @map("balance_after")
  created_at        DateTime      @default(now()) @map("created_at")
  user              users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("credit_transactions")
}

model tokens {
  id         BigInt     @id @default(autoincrement()) @map("id")
  user_id    BigInt     @map("user_id")
  code       String     @unique @map("code") @db.Uuid
  type       token_type @map("type")
  expires_at DateTime   @map("expires_at") @db.Timestamp(6)
  is_used    Boolean    @map("is_used")
  user       users      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Prisma/Postgres không tự index FK — cascade delete theo user cần index này.
  @@index([user_id])
  @@map("tokens")
}

model sources {
  id                    BigInt           @id @default(autoincrement()) @map("id")
  url                   String           @unique @map("url") @db.VarChar(1000)
  normalized_url        String           @unique @map("normalized_url") @db.VarChar(1000)
  title                 String?          @map("title") @db.VarChar(255)
  type                  source_type      @map("type")
  // jsonb thay vì Text-chứa-JSON-string: query được, DB validate cấu trúc JSON.
  metadata              Json?            @map("metadata")
  created_at            DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  // WP2.2 — transcript lưu Ở ĐÂY DUY NHẤT (mục 6.5 economics doc): mọi
  // AIGeneration của Source này tham chiếu qua source_id, không tự lưu lại
  // transcript riêng — tránh nhân bản phần nặng nhất N lần theo số bản AI.
  // Nullable + fetched_at: fetch lazy khi user bấm dùng AI lần đầu.
  transcript            String?          @map("transcript") @db.Text
  transcript_fetched_at DateTime?        @map("transcript_fetched_at")
  // WP4.2 — "lần cuối thật sự được dùng"; tín hiệu chính cho archiveStaleData.
  last_accessed_at      DateTime?        @map("last_accessed_at")
  // WP4.2 — đánh dấu đã archive (mục 6.4); không xoá row, chỉ null hoá
  // transcript ở tầng application để giữ cache-key/audit nhất quán.
  archived_at           DateTime?        @map("archived_at")
  lessons               lessons[]
  // WP1.10.1 — courses created from this source (1 URL → 1 không gian học).
  courses               courses[]
  ai_generations        ai_generations[]

  @@map("sources")
}

// WP2.1 — 1 bản output AI cụ thể (tóm tắt hoặc quiz), theo
// docs/design/ai-personalization-economics.md mục 3.
model ai_generations {
  id                   BigInt         @id @default(autoincrement()) @map("id")
  source_id            BigInt         @map("source_id")
  // hash(type, params, segmentRange, modelVersion) — modelVersion bắt buộc
  // nằm trong hash (ghi chú 1, mục 3 economics doc) để nâng cấp model tự
  // tạo cache-miss có kiểm soát, không cần xoá tay bản cache cũ.
  recipe_hash          String         @map("recipe_hash") @db.VarChar(128)
  recipe_type          ai_recipe_type @map("recipe_type")
  // true chỉ khi recipe == cấu hình mặc định hệ thống, không do user chọn
  // tham số nào (kể cả segment) — ranh giới cứng ở mục 2 economics doc.
  is_default_recipe    Boolean        @default(false) @map("is_default_recipe")
  // Nguồn chi phí gốc, quyết định luật free-rider ở mục 5 economics doc.
  key_source           ai_key_source  @map("key_source")
  // NULL nếu hệ thống seed HOẶC user gốc đã xoá tài khoản (ghi chú 2, mục 3)
  // — không cascade-delete theo user, giữ nguyên content/visibility.
  generated_by_user_id BigInt?        @map("generated_by_user_id")
  // SHARED chỉ hợp lệ khi key_source = BYOK (ràng buộc 2, mục 3);
  // key_source = PAID_TIER luôn bị ép cứng PRIVATE ở tầng service.
  visibility           ai_visibility  @default(PRIVATE) @map("visibility")
  // Enqueue nhẹ (ai-integration-plan.md mục 4): route POST trả 202 ngay với
  // PENDING, xử lý trong cùng process, UI poll.
  status               ai_status      @default(PENDING) @map("status")
  model_version        String         @map("model_version") @db.VarChar(50)
  // Output đã xử lý — KHÔNG chứa lại transcript gốc (mục 6.5 economics doc).
  content              String?        @map("content") @db.Text
  error                String?        @map("error") @db.Text
  created_at           DateTime       @default(now()) @map("created_at")
  updated_at           DateTime       @default(now()) @updatedAt @map("updated_at")
  // WP4.2 — content bị null hoá ở tầng application khi archive, không xoá
  // row (giữ recipe_hash cho cache-key).
  archived_at          DateTime?      @map("archived_at")

  source            sources   @relation(fields: [source_id], references: [id])
  generated_by_user users?    @relation(fields: [generated_by_user_id], references: [id], onDelete: SetNull)
  lessons           lessons[]

  // Non-unique here on purpose: Prisma schema syntax can't express a partial
  // unique index. The real RÀNG BUỘC 1 constraint — unique(source_id,
  // recipe_hash) WHERE key_source = 'SHARED_FREE' — lives directly in the
  // migration SQL (prisma/migrations/20260814180000_add_ai_generations).
  @@index([source_id, recipe_hash])
  @@index([generated_by_user_id, created_at])
  @@map("ai_generations")
}

model courses {
  id                    BigInt              @id @default(autoincrement()) @map("id")
  // WP1.6 follow-up — `lecturer_id` was dropped entirely; `owner_id` is the
  // sole identity field (ownership model, not marketplace).
  owner_id              BigInt              @map("owner_id")
  title                 String              @map("title") @db.VarChar(255)
  slug                  String              @unique @map("slug") @db.VarChar(255)
  share_token           String?             @unique @map("share_token") @db.VarChar(100)
  description           String?             @map("description") @db.Text
  status                course_status       @default(ACTIVE) @map("status")
  // WP1.5.12 — records which course a "Sao chép về học" clone came from.
  // Self-FK SetNull (2026-08-21): xoá course gốc thì clone mất lineage chứ
  // không giữ id dangling trỏ vào hư không.
  cloned_from_course_id BigInt?             @map("cloned_from_course_id")
  // WP1.6.2 — "/my-learning" shows this as the "enrolled at" date.
  created_at            DateTime            @default(now()) @map("created_at")
  updated_at            DateTime            @default(now()) @updatedAt @map("updated_at")
  // WP1.9 — public showcase artifact tag (outreach/audit; no route filters on it).
  is_showcase           Boolean             @default(false) @map("is_showcase")
  // WP1.10.1 — "course này sinh từ nguồn nào", neo ở tầng course khớp mô hình
  // "1 URL → 1 không gian học". Nullable vì course tạo trống không có nguồn.
  // Clone copy nguyên giá trị này — xuất xứ nội dung không đổi khi đổi chủ.
  source_id             BigInt?             @map("source_id")
  chapters              chapters[]
  learning_progress     learning_progress[]
  notes                 notes[]
  owner                 users               @relation("CourseOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  source                sources?            @relation(fields: [source_id], references: [id], onDelete: SetNull)
  cloned_from           courses?            @relation("CourseCloneOrigin", fields: [cloned_from_course_id], references: [id], onDelete: SetNull)
  clones                courses[]           @relation("CourseCloneOrigin")

  // Postgres allows multiple NULLs through a unique index, so this only
  // constrains actual clones — what makes cloneForOwner's check-then-create
  // race-safe under concurrent double-submits.
  @@unique([owner_id, cloned_from_course_id])
  @@index([owner_id])
  @@index([source_id])
  @@map("courses")
}

model chapters {
  id          BigInt    @id @default(autoincrement()) @map("id")
  course_id   BigInt    @map("course_id")
  title       String    @map("title") @db.VarChar(255)
  order_index Int       @map("order_index")
  course      courses   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons     lessons[]

  @@index([course_id])
  @@map("chapters")
}

model lessons {
  id                BigInt              @id @default(autoincrement()) @map("id")
  chapter_id        BigInt              @map("chapter_id")
  source_id         BigInt?             @map("source_id")
  title             String              @map("title") @db.VarChar(255)
  type              lesson_type         @map("type")
  content_url       String?             @map("content_url") @db.VarChar(500)
  order_index       Int                 @map("order_index")
  updated_at        DateTime            @default(now()) @updatedAt @map("updated_at")
  // WP2.1 — NULL hợp lệ luôn: tổ chức/học/theo dõi tiến độ không cần chạm AI
  // (mục 8 economics doc, "core free mãi mãi").
  ai_generation_id  BigInt?             @map("ai_generation_id")
  chapter           chapters            @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  source            sources?            @relation(fields: [source_id], references: [id], onDelete: SetNull)
  ai_generation     ai_generations?     @relation(fields: [ai_generation_id], references: [id], onDelete: SetNull)
  learning_progress learning_progress[]
  questions         questions[]
  notes             notes[]

  @@index([chapter_id])
  @@index([source_id])
  @@index([ai_generation_id])
  @@map("lessons")
}

// WP1.5.4: many notes per lesson, each optionally pinned to a video
// timestamp so clicking it can seek the player there.
model notes {
  id                  BigInt   @id @default(autoincrement()) @map("id")
  user_id             BigInt   @map("user_id")
  lesson_id           BigInt   @map("lesson_id")
  course_id           BigInt   @map("course_id")
  content             String   @map("content") @db.Text
  video_timestamp_sec Int?     @map("video_timestamp_sec")
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @default(now()) @updatedAt @map("updated_at")
  user                users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson              lessons  @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  course              courses  @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([user_id, lesson_id])
  @@index([course_id])
  @@map("notes")
}

model learning_progress {
  id                  BigInt    @id @default(autoincrement()) @map("id")
  // NOT NULL (2026-08-21): trước đây nullable làm unique(user_id, lesson_id)
  // vô hiệu với row NULL (Postgres cho vô số NULL trùng nhau). Không có use
  // case progress vô danh nên siết cứng luôn. `personal_note` legacy (đã
  // thay bằng bảng notes) cũng bị drop.
  user_id             BigInt    @map("user_id")
  course_id           BigInt    @map("course_id")
  lesson_id           BigInt    @map("lesson_id")
  is_finished         Boolean   @default(false) @map("is_finished")
  video_last_position Int?      @map("video_last_position")
  quiz_max_score      Int?      @map("quiz_max_score")
  quiz_start_time     DateTime? @map("quiz_start_time")
  quiz_question_ids   String?   @map("quiz_question_ids") @db.Text
  lesson              lessons   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  user                users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course              courses   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  // WP1.3: progress is keyed by ownership (user_id + lesson_id).
  @@unique([user_id, lesson_id])
  @@index([user_id, course_id])
  @@index([course_id])
  @@map("learning_progress")
}

model questions {
  id         BigInt  @id @default(autoincrement()) @map("id")
  lesson_id  BigInt  @map("lesson_id")
  content    String  @map("content") @db.Text
  answer_key String? @map("answer_key") @db.VarChar(255)
  // JSON array of option strings (2026-08-21) — thay 4 cột option_a..d cứng:
  // hết pad-'' khi <4 đáp án, hết trần 4 đáp án, hết VarChar(255) cắt text.
  // Số đáp án tối đa giờ là business rule ở QuizValidationPolicy, không phải
  // giới hạn storage.
  options    Json    @map("options")
  lesson     lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([lesson_id])
  @@map("questions")
}
