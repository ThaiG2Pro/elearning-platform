generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                BigInt              @id @default(autoincrement()) @map("id")
  email             String              @unique @db.VarChar(255) @map("email")
  password_hash     String              @db.VarChar(255) @map("password_hash")
  full_name         String              @db.VarChar(100) @map("full_name")
  age               Int?                @map("age")
  role_id           Int                 @map("role_id")
  status            String              @db.VarChar(20) @map("status")
  created_at        DateTime?           @db.Timestamp(6) @map("created_at")
  // WP1.5.6: client-side-resized avatar image, stored as a data: URL — no
  // file storage exists anywhere in this codebase (no S3/disk-upload infra)
  // and this app targets Vercel-style serverless where writing to disk at
  // runtime isn't reliable, so the DB is the simplest safe place for it.
  avatar_url        String?             @db.Text @map("avatar_url")
  owned_courses     courses[]           @relation("CourseOwner")
  learning_progress learning_progress[]
  notes             notes[]
  role              roles               @relation(fields: [role_id], references: [id])
  tokens            tokens[]

  @@map("users")
}

model roles {
  id    Int     @id @default(autoincrement()) @map("id")
  name  String  @db.VarChar(20) @map("name")
  users users[]

  @@map("roles")
}

model tokens {
  id         BigInt   @id @default(autoincrement()) @map("id")
  user_id    BigInt   @map("user_id")
  code       String   @unique @db.Uuid @map("code")
  type       String   @db.VarChar(20) @map("type")
  expires_at DateTime @db.Timestamp(6) @map("expires_at")
  is_used    Boolean  @map("is_used")
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model sources {
  id             BigInt    @id @default(autoincrement()) @map("id")
  url            String    @unique @db.VarChar(1000) @map("url")
  normalized_url String    @unique @db.VarChar(1000) @map("normalized_url")
  title          String?   @db.VarChar(255) @map("title")
  type           String    @db.VarChar(50) @map("type")
  metadata       String?   @db.Text @map("metadata")
  created_at     DateTime? @default(now()) @db.Timestamp(6) @map("created_at")
  lessons        lessons[]

  @@map("sources")
}

model courses {
  id                    BigInt              @id @default(autoincrement()) @map("id")
  // WP1.6 follow-up — this used to be paired with a `lecturer_id` column,
  // a leftover from the marketplace model where a course's "author" and its
  // "owner" could in theory differ. In the ownership model they never do —
  // every write path set both to the same value — so `lecturer_id` was
  // dropped entirely; `owner_id` is now the sole identity field.
  owner_id              BigInt              @map("owner_id")
  title                 String              @db.VarChar(255) @map("title")
  slug                  String              @unique @db.VarChar(255) @map("slug")
  share_token           String?             @unique @db.VarChar(100) @map("share_token")
  description           String?             @db.Text @map("description")
  status                String              @default("active") @db.VarChar(20) @map("status")
  // WP1.5.12 — records which course a "Sao chép về học" clone came from, so
  // cloneForOwner can dedupe: same (owner, source) pair reuses the existing
  // clone instead of creating a duplicate on a double-submit/double-fire.
  cloned_from_course_id BigInt?             @map("cloned_from_course_id")
  // WP1.6.2 — "/my-learning" shows this as the "enrolled at" date, reading
  // owned courses directly instead of the (now-removed) legacy `enrollments`
  // table's own enrolled_at column.
  created_at            DateTime            @default(now()) @map("created_at")
  chapters          chapters[]
  learning_progress learning_progress[]
  notes             notes[]
  owner             users               @relation("CourseOwner", fields: [owner_id], references: [id])

  // Postgres allows multiple NULLs through a unique index, so this only
  // constrains actual clones (cloned_from_course_id set) — owner-authored
  // courses are unaffected. This is what makes cloneForOwner's
  // check-then-create race-safe under concurrent double-submits.
  @@unique([owner_id, cloned_from_course_id])
  @@map("courses")
}

model chapters {
  id          BigInt    @id @default(autoincrement()) @map("id")
  course_id   BigInt    @map("course_id")
  title       String    @db.VarChar(255) @map("title")
  order_index Int       @map("order_index")
  course      courses   @relation(fields: [course_id], references: [id])
  lessons     lessons[]

  @@map("chapters")
}

model lessons {
  id                BigInt              @id @default(autoincrement()) @map("id")
  chapter_id        BigInt              @map("chapter_id")
  source_id         BigInt?             @map("source_id")
  title             String              @db.VarChar(255) @map("title")
  type              String              @db.VarChar(20) @map("type")
  content_url       String?             @db.VarChar(500) @map("content_url")
  order_index       Int                 @map("order_index")
  chapter           chapters            @relation(fields: [chapter_id], references: [id])
  source            sources?            @relation(fields: [source_id], references: [id])
  learning_progress learning_progress[]
  questions         questions[]
  notes             notes[]

  @@map("lessons")
}

// WP1.5.4: notes used to "ride" on learning_progress.personal_note — one
// note per (user, lesson), no timestamp, no delete. A real note-taking
// feature needs its own table: many notes per lesson, each optionally
// pinned to a video timestamp so clicking it can seek the player there.
model notes {
  id                  BigInt   @id @default(autoincrement()) @map("id")
  user_id             BigInt   @map("user_id")
  lesson_id           BigInt   @map("lesson_id")
  course_id           BigInt   @map("course_id")
  content             String   @db.Text @map("content")
  video_timestamp_sec Int?     @map("video_timestamp_sec")
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @default(now()) @updatedAt @map("updated_at")
  user                users    @relation(fields: [user_id], references: [id])
  lesson              lessons  @relation(fields: [lesson_id], references: [id])
  course              courses  @relation(fields: [course_id], references: [id])

  @@index([user_id, lesson_id])
  @@map("notes")
}

model learning_progress {
  id                  BigInt    @id @default(autoincrement()) @map("id")
  user_id             BigInt?   @map("user_id")
  course_id           BigInt?   @map("course_id")
  lesson_id           BigInt    @map("lesson_id")
  is_finished         Boolean   @default(false) @map("is_finished")
  video_last_position Int?      @map("video_last_position")
  quiz_max_score      Int?      @map("quiz_max_score")
  quiz_start_time     DateTime? @map("quiz_start_time")
  personal_note       String?   @db.Text @map("personal_note")
  quiz_question_ids   String?   @db.Text @map("quiz_question_ids")
  lesson              lessons   @relation(fields: [lesson_id], references: [id])
  user                users?    @relation(fields: [user_id], references: [id])
  course              courses?  @relation(fields: [course_id], references: [id])

  // WP1.3: progress is keyed by ownership (user_id + lesson_id), not by the
  // marketplace enrollment row — this is the identity going forward. The
  // legacy `enrollments` table and this row's enrollment_id FK (WP1.6, follow-
  // up cleanup) were dropped entirely: both were confirmed empty/unread in
  // production and nothing in the codebase writes to `enrollments` anymore.
  @@unique([user_id, lesson_id])
  @@map("learning_progress")
}

model questions {
  id          BigInt  @id @default(autoincrement()) @map("id")
  lesson_id   BigInt  @map("lesson_id")
  content     String  @db.Text @map("content")
  answer_key  String? @db.VarChar(255) @map("answer_key")
  option_a    String  @db.VarChar(255) @map("option_a")
  option_b    String  @db.VarChar(255) @map("option_b")
  option_c    String  @db.VarChar(255) @map("option_c")
  option_d    String  @db.VarChar(255) @map("option_d")
  lesson      lessons @relation(fields: [lesson_id], references: [id])

  @@map("questions")
}
